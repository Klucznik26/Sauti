+/*
+SAUTI: CPU capabilities are ONE word, written exactly once per computation with an atomic store and read with atomic loads. The original kept several plain globals that every
+dr_flac_open() rewrote (a data race when several threads open FLAC files at the same time; upstream silenced ThreadSanitizer instead of fixing it). Every thread that holds a decoder
+has run drflac__init_cpu_caps() itself, and the stored word is complete (computed in a local first), so a reader sees either 0 (nothing detected: the portable code path) or the full value.
+The names drflac__gIs*Supported are kept as read-only accessors, so the call sites are unchanged.
+*/
+#define DRFLAC_CAP_INIT   0x01u
+#define DRFLAC_CAP_SSE2   0x02u
+#define DRFLAC_CAP_SSE41  0x04u
+#define DRFLAC_CAP_LZCNT  0x08u
+#define DRFLAC_CAP_NEON   0x10u
+static drflac_uint32 drflac__gCpuCaps = 0;
+#if defined(__GNUC__) || defined(__clang__)
+    #define DRFLAC_CAPS_LOAD()       ((drflac_uint32)__atomic_load_n(&drflac__gCpuCaps, __ATOMIC_RELAXED))
+    #define DRFLAC_CAPS_STORE(v)     __atomic_store_n(&drflac__gCpuCaps, (drflac_uint32)(v), __ATOMIC_RELAXED)
+#elif defined(_MSC_VER)
+    #define DRFLAC_CAPS_LOAD()       ((drflac_uint32)_InterlockedOr((volatile long*)&drflac__gCpuCaps, 0))
+    #define DRFLAC_CAPS_STORE(v)     ((void)_InterlockedExchange((volatile long*)&drflac__gCpuCaps, (long)(v)))
